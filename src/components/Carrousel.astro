---
import type { ImageMetadata } from "astro";

interface Props {
  images: (ImageMetadata | string)[];
  title?: string;
  folderHint?: string;
}

const { images = [], title = "Project", folderHint } = Astro.props;
const currentLocale = Astro.currentLocale || "en";
const hasImages = images.length > 0;
---

{
  hasImages ? (
    <div
      class="my-10 w-[calc(100%+2rem)] -translate-x-4 lg:w-[calc(100%+8rem)] lg:-translate-x-16"
      data-carousel-root
      aria-roledescription="carousel"
      aria-label={title}
    >
      <div class="relative w-full overflow-hidden rounded-lg">
        <div
          data-carousel-track
          class="flex h-80 w-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden scroll-smooth [scrollbar-width:none] min-[500px]:h-96 sm:h-[460px] min-[800px]:h-[600px] lg:h-[640px] [&::-webkit-scrollbar]:hidden"
        >
          {images.map((item: ImageMetadata | string, index: number) => {
            if (typeof item === "object") {
              return (
                <div
                  class="relative h-full w-full shrink-0 snap-center overflow-hidden"
                  data-carousel-slide
                >
                  <img
                    src={item.src}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                    class="relative left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 object-cover"
                    alt={`${title} - ${index + 1}`}
                  />
                </div>
              );
            }
            if (item.startsWith("https")) {
              return (
                <div
                  class="relative h-full w-full shrink-0 snap-center overflow-hidden"
                  data-carousel-slide
                >
                  <iframe
                    title={`${title} Video`}
                    width="560"
                    height="315"
                    src={`${item}?amp&rel=0&mute=1`}
                    allowfullscreen
                    loading="lazy"
                    class="absolute left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 bg-black object-cover"
                  />
                </div>
              );
            }
            return (
              <div
                class="relative h-full w-full shrink-0 snap-center overflow-hidden"
                data-carousel-slide
              >
                <img
                  src={item}
                  loading="lazy"
                  decoding="async"
                  class="relative left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 object-cover"
                  alt={`${title} - ${index + 1}`}
                />
              </div>
            );
          })}
        </div>

        {images.length > 1 && (
          <>
            <button
              type="button"
              class="group absolute left-3 top-1/2 z-30 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/20 bg-black/60 text-white backdrop-blur-sm transition hover:bg-black/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300"
              data-carousel-prev
              aria-label={currentLocale === "es" ? "Imagen anterior" : "Previous image"}
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </button>

            <button
              type="button"
              class="group absolute right-3 top-1/2 z-30 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/20 bg-black/60 text-white backdrop-blur-sm transition hover:bg-black/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-300"
              data-carousel-next
              aria-label={currentLocale === "es" ? "Imagen siguiente" : "Next image"}
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          </>
        )}
      </div>
    </div>
  ) : (
    folderHint && (
      <div class="my-6 flex h-56 w-full flex-col items-center justify-center rounded-xl border border-dashed border-white/20 bg-black/30 p-6 text-center text-sm text-gray-300">
        <p class="font-medium text-white/90">
          {currentLocale === "es"
            ? `Capturas de ${title} listas para cargar`
            : `${title} screenshots ready to load`}
        </p>
        <p class="mt-1 font-mono text-xs text-sky-300/80">{folderHint}</p>
      </div>
    )
  )
}

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-carousel-root]");
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  roots.forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const slides = track?.querySelectorAll("[data-carousel-slide]");
    const count = slides?.length ?? 0;

    if (!track || count <= 1) return;

    const currentIndex = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));

    const goTo = (index: number) => {
      const target = ((index % count) + count) % count;
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: motionQuery.matches ? "auto" : "smooth",
      });
    };

    prev?.addEventListener("click", () => goTo(currentIndex() - 1));
    next?.addEventListener("click", () => goTo(currentIndex() + 1));

    if (!motionQuery.matches) {
      let timer = 0;
      let paused = false;

      const start = () => {
        window.clearInterval(timer);
        if (paused || document.hidden) return;
        timer = window.setInterval(() => goTo(currentIndex() + 1), 4000);
      };

      const stop = () => {
        window.clearInterval(timer);
        timer = 0;
      };

      root.addEventListener("pointerenter", () => {
        paused = true;
        stop();
      });
      root.addEventListener("pointerleave", () => {
        paused = false;
        start();
      });
      root.addEventListener("focusin", () => {
        paused = true;
        stop();
      });
      root.addEventListener("focusout", (e) => {
        if (root.contains(e.relatedTarget as Node | null)) return;
        paused = false;
        start();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    }
  });
</script>

---
import LinkButton from "../components/LinkButton.astro";

interface Props {
  link?: string | string[];
  summary?: string;
  bullets?: string[];
  company: string;
  date: string;
  title: string;
  more?: string | string[];
}

const { link, company, summary, bullets = [], title, date, more } = Astro.props;
const primaryLink = Array.isArray(link) ? link[0] : link;
---

<div
  class="absolute -start-1.5 mt-1.5 h-3 w-3 rounded-full border border-white bg-gray-200 dark:border-gray-900 dark:bg-gray-700"
>
</div>
<time class="mb-1 text-sm font-normal leading-none text-sky-200/80">{date}</time>
<h3 class="mt-2 text-xl font-semibold text-yellow-200">
  {title} ·{" "}
  {
    primaryLink ? (
      <a
        href={primaryLink}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/95 underline decoration-white/30 underline-offset-4 transition hover:text-yellow-300"
      >
        {company}
      </a>
    ) : (
      <span class="text-white/95">{company}</span>
    )
  }
</h3>

{summary && <p class="mt-2 text-pretty text-base font-medium text-sky-100/90">{summary}</p>}

{
  bullets.length > 0 && (
    <ul class="mb-4 mt-3 list-disc space-y-2 text-pretty pl-5 text-base font-normal text-gray-200">
      {bullets.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )
}

<div class="mt-3 flex flex-wrap gap-2">
  {
    Array.isArray(link) ? (
      link.map((url, index) => (
        <LinkButton link={url}>
          {Array.isArray(more) && more[index]}
          <svg
            class="ms-2 h-3 w-3 rtl:rotate-180"
            aria-hidden="true"
            fill="none"
            viewBox="0 0 14 10"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M1 5h12m0 0L9 1m4 4L9 9"
            />
          </svg>
        </LinkButton>
      ))
    ) : link ? (
      <LinkButton link={link}>
        {more === "" ? "Learn more..." : more}
        <svg class="ms-2 h-3 w-3 rtl:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 14 10">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"
          />
        </svg>
      </LinkButton>
    ) : null
  }
</div>

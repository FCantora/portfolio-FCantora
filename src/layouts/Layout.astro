---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/onest";
import { getRelativeLocaleUrl } from "astro:i18n";
import { buildLocaleHash } from "../lib/links";
import { Image } from "astro:assets";
import esFlag from "../assets/es.png";
import enFlag from "../assets/en.png";
import profilePhoto from "../assets/fcantora.jpg";
import headerScriptUrl from "../scripts/header.ts?url";

interface Props {
  title: string;
  description: string;
}

const currentLocale = Astro.currentLocale || "es";
const { description, title } = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const esUrl = new URL("/es/", siteOrigin).href;
const enUrl = new URL("/en/", siteOrigin).href;
const ogImageUrl = new URL("/portfolio-preview.png", siteOrigin).href;
const personImageUrl = new URL(profilePhoto.src, siteOrigin).href;
const ogImageAlt =
  currentLocale === "es"
    ? "Fernando Cantora — Technical Project / Product Manager & Solutions Lead"
    : "Fernando Cantora — Technical Project / Product Manager & Solutions Lead";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin.href}#website`,
      url: siteOrigin.href,
      name: "Fernando Cantora — Portfolio",
      inLanguage: ["es-AR", "en-US"],
    },
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: currentLocale === "es" ? "es-AR" : "en-US",
      isPartOf: { "@id": `${siteOrigin.href}#website` },
      mainEntity: { "@id": `${siteOrigin.href}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteOrigin.href}#person`,
      name: "Fernando Cantora",
      givenName: "Fernando",
      familyName: "Cantora",
      jobTitle: "Technical Project / Product Manager & Solutions Lead",
      description,
      url: canonicalUrl,
      image: personImageUrl,
      email: "mailto:fer.cantora90@gmail.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Buenos Aires",
        addressCountry: "AR",
      },
      sameAs: [
        "https://www.linkedin.com/in/fcantora/",
        "https://github.com/FCantora",
        "https://calendly.com/fercantora/30min",
      ],
      knowsLanguage: [
        { "@type": "Language", name: "Spanish", alternateName: "es" },
        { "@type": "Language", name: "English", alternateName: "en" },
        { "@type": "Language", name: "Portuguese", alternateName: "pt" },
      ],
      knowsAbout: [
        "Technical Product Management",
        "Product Discovery & Requirements Elicitation",
        "As-Is / To-Be Process Mapping",
        "MVP Scoping & Effort Estimation",
        "User Acceptance Testing (UAT)",
        "Stakeholder Management",
        "Fullstack Software Engineering",
        "Next.js",
        "React",
        "Astro",
        "TypeScript",
        "Supabase",
        "PostgreSQL",
        "Brevo Email Marketing Automation",
      ],
      alumniOf: [
        {
          "@type": "CollegeOrUniversity",
          name: "Universidad Nacional de las Artes (UNA)",
        },
        {
          "@type": "EducationalOrganization",
          name: "SoyHenry Bootcamp",
        },
      ],
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={currentLocale === "es" ? "es-AR" : "en-US"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fernando Cantora" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Favicons & PWA Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={profilePhoto.src} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1e3a8a" />

    <!-- Canonical & Internationalization (Hreflang) -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="es-AR" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph / LinkedIn / WhatsApp -->
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Fernando" />
    <meta property="profile:last_name" content="Cantora" />
    <meta property="profile:username" content="fcantora" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Fernando Cantora — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={currentLocale === "es" ? "es_AR" : "en_US"} />
    <meta property="og:locale:alternate" content={currentLocale === "es" ? "en_US" : "es_AR"} />

    <!-- X (Twitter) Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD ProfilePage + Person + WebSite) -->
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
  </head>
  <body>
    <div
      class="fixed inset-0 -z-10 h-full w-full items-center px-5 py-24 [background:radial-gradient(125%_125%_at_50%_10%,#000_40%,#3b82f6_100%)]"
    >
    </div>
    <div class="xs:w-full relative mx-auto w-full xl:w-[1120px]">
      <Header currentLocale={currentLocale} getRelativeLocaleUrl={getRelativeLocaleUrl} />
      <button
        id="menu-btn"
        aria-label={currentLocale === "es" ? "Abrir menú" : "Open menu"}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="absolute left-4 top-6 z-50 flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border border-black/50 bg-white/10 shadow-sm backdrop-blur transition hover:scale-105 lg:hidden"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-8 w-8 opacity-80"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M3.75 6.75A.75.75 0 0 1 4.5 6h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 5.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm.75 4.5a.75.75 0 0 0 0 1.5h15a.75.75 0 0 0 0-1.5h-15Z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
      <nav
        id="mobile-menu"
        aria-label={currentLocale === "es" ? "Menú móvil" : "Mobile menu"}
        class="pointer-events-none absolute left-16 top-6 z-50 flex flex-col gap-2 rounded-2xl border border-white/15 bg-black/80 p-2 opacity-0 shadow-xl backdrop-blur-xl transition lg:hidden"
      >
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href={buildLocaleHash(getRelativeLocaleUrl, currentLocale, "/#top")}
        >
          {currentLocale === "es" ? "Inicio" : "Home"}
        </a>
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href={buildLocaleHash(getRelativeLocaleUrl, currentLocale, "/#projects")}
        >
          {currentLocale === "es" ? "Proyectos" : "Projects"}
        </a>
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href={buildLocaleHash(getRelativeLocaleUrl, currentLocale, "/#experience")}
        >
          {currentLocale === "es" ? "Experiencia" : "Experience"}
        </a>
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href={buildLocaleHash(getRelativeLocaleUrl, currentLocale, "/#about")}
        >
          {currentLocale === "es" ? "Sobre mí" : "About"}
        </a>
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href={buildLocaleHash(getRelativeLocaleUrl, currentLocale, "/#certifications")}
        >
          {currentLocale === "es" ? "Certificaciones" : "Certifications"}
        </a>
        <a
          class="rounded-full px-3 py-2 transition hover:bg-white/10"
          href="https://calendly.com/fercantora/30min"
          target="_blank"
          rel="noopener noreferrer"
        >
          {currentLocale === "es" ? "Contacto" : "Contact"}
        </a>
      </nav>
      <nav
        id="lang-switcher"
        aria-label={currentLocale === "es" ? "Selector de idioma" : "Language switcher"}
        class="absolute right-4 top-6 z-50 flex items-center gap-2"
      >
        <a
          href={buildLocaleHash(getRelativeLocaleUrl, "es", "/#top")}
          aria-label="Cambiar a Español"
          class={`w-8 h-8 rounded-full overflow-hidden border flex items-center justify-center hover:scale-105 transition shadow-sm ${currentLocale === "es" ? "border-yellow-400 ring-1 ring-yellow-900" : "border-black/50"}`}
          data-page-transition
          title="Español"
        >
          <Image
            src={esFlag}
            alt="Español"
            width={64}
            height={64}
            class="h-full w-full opacity-60 transition hover:opacity-100"
          />
        </a>
        <a
          href={buildLocaleHash(getRelativeLocaleUrl, "en", "/#top")}
          aria-label="Switch to English"
          class={`w-8 h-8 rounded-full overflow-hidden border flex items-center justify-center hover:scale-105 transition shadow-sm ${currentLocale === "en" ? "border-yellow-400 ring-1 ring-yellow-900" : "border-black/50"}`}
          data-page-transition
          title="English"
        >
          <Image
            src={enFlag}
            alt="English"
            width={64}
            height={64}
            class="h-full w-full opacity-60 transition hover:opacity-100"
          />
        </a>
      </nav>
    </div>
    <!-- Spacer to offset the fixed header height -->
    <div class="md:h-24"></div>
    <slot />
    <button
      id="back-to-top"
      aria-label={currentLocale === "es" ? "Volver arriba" : "Back to top"}
      class="pointer-events-none fixed bottom-4 right-4 z-50 flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-white/10 p-3 opacity-0 shadow-lg transition hover:bg-white/20 lg:hidden"
      type="button"
    >
      <span class="text-2xl" aria-hidden="true">↑</span>
    </button>
    <div
      id="page-loader"
      class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm"
    >
      <div
        class="h-10 w-10 animate-spin rounded-full border-4 border-white/30 border-t-white"
        aria-label="Loading"
      >
      </div>
    </div>
    <script type="module" src={headerScriptUrl}></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js");
        });
      }
    </script>
    <Footer currentLocale={currentLocale} getRelativeLocaleUrl={getRelativeLocaleUrl} />
  </body>

  <style is:global>
    :root {
      color-scheme: dark;
    }
    html {
      font-family: "Onest Variable", system-ui, sans-serif;
      scroll-behavior: smooth;
    }
    body {
      background: #292727;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }
    /* Header hide/show animation */
    header {
      transition: transform 200ms ease;
    }
    header.is-hidden {
      transform: translateY(-100%);
    }
  </style>
</html>
